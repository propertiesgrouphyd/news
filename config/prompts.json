
/* ============================================================
   VIDHWAAN TELUGU NEWS
   FINAL PROMPT BUILDER
   File: prompt.js

   Features:
   - Native Telugu newspaper writing instructions
   - Strict political party name dictionary
   - Original fact preservation
   - Natural Telugu grammar and vocabulary
   - Foreign-language contamination checks
   - Generated article validation
   - Compatible with buildPrompt(article)
============================================================ */

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";


/* ============================================================
   CONFIGURATION
============================================================ */

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const PROMPTS_PATH = path.join(
    __dirname,
    "prompts.json"
);

const MAX_SOURCE_LENGTH = 12000;


/* ============================================================
   OFFICIAL POLITICAL PARTY NAMES

   Never transliterate these abbreviations letter by letter.
============================================================ */

export const PARTY_NAMES = Object.freeze({

    "BJP": "బీజేపీ",
    "BHARATIYA JANATA PARTY": "భారతీయ జనతా పార్టీ",

    "TDP": "టీడీపీ",
    "TELUGU DESAM PARTY": "తెలుగుదేశం పార్టీ",

    "JSP": "జేఎస్పీ",
    "JANASENA": "జనసేన",
    "JANA SENA": "జనసేన",
    "JANA SENA PARTY": "జనసేన పార్టీ",

    "YSRCP": "వైఎస్సార్ కాంగ్రెస్",
    "YSR CONGRESS": "వైఎస్సార్ కాంగ్రెస్",
    "YSR CONGRESS PARTY": "వైఎస్సార్ కాంగ్రెస్",

    "BRS": "బీఆర్ఎస్",
    "BHARAT RASHTRA SAMITHI": "భారత్ రాష్ట్ర సమితి",

    "INC": "కాంగ్రెస్",
    "INDIAN NATIONAL CONGRESS": "కాంగ్రెస్",
    "CONGRESS": "కాంగ్రెస్"

});


/* ============================================================
   COMMON TELUGU ERROR DETECTION

   These are rejection checks, not blind replacements.
============================================================ */

const FORBIDDEN_TERMS = [

    "బిఎజె",
    "బాజ్",
    "బీజీపీ",

    "టిడిపీ",
    "టిడిపి",

    "యెసీఆర్ కాంగ్రెస్",

    "జిల్లా పరిపాలక మండలి",

    "ఏకైకంగా ఎన్నికయ్యారు",

    "breakdownలు",

    "Demonstrations జరిగింది",

    "강조",
    "했습니다"

];


/* ============================================================
   LOAD PROMPTS.JSON
============================================================ */

function loadPromptConfig() {

    try {

        if (!fs.existsSync(PROMPTS_PATH)) {
            throw new Error(
                "prompts.json was not found."
            );
        }

        const raw = fs.readFileSync(
            PROMPTS_PATH,
            "utf8"
        );

        const config = JSON.parse(raw);

        if (
            !Array.isArray(config.system) ||
            !Array.isArray(config.userPrompt) ||
            !config.articleSchema
        ) {
            throw new Error(
                "prompts.json has an invalid structure."
            );
        }

        return config;

    } catch (error) {

        console.error(
            "Prompt configuration error:",
            error.message
        );

        throw error;

    }

}


/* ============================================================
   TEXT HELPERS
============================================================ */

function cleanText(value) {

    if (value === null || value === undefined) {
        return "";
    }

    if (typeof value === "string") {
        return value.trim();
    }

    if (typeof value === "number") {
        return String(value);
    }

    return "";

}


function getSourceContent(article) {

    const possibleContent = [
        article.text,
        article.content,
        article.fullText,
        article.body,
        article.description,
        article.excerpt
    ];

    return possibleContent
        .map(cleanText)
        .filter(Boolean)
        .join("\n\n")
        .slice(0, MAX_SOURCE_LENGTH);

}


/* ============================================================
   EXTRACT VERIFIED SOURCE FACTS
============================================================ */

export function extractVerifiedFacts(article) {

    if (
        !article ||
        typeof article !== "object"
    ) {
        throw new Error(
            "Invalid source article supplied to buildPrompt()."
        );
    }

    const facts = {

        originalTitle: cleanText(
            article.title ||
            article.headline
        ),

        originalSummary: cleanText(
            article.excerpt ||
            article.summary
        ),

        originalContent: getSourceContent(article),

        publishedDate: cleanText(
            article.published ||
            article.pubDate ||
            article.date
        ),

        category: cleanText(
            article.category
        ),

        originalLocation: cleanText(
            article.location
        ),

        verifiedNames: cleanText(
            article.names
        ),

        verifiedFacts: cleanText(
            article.verifiedFacts
        )

    };

    if (
        !facts.originalTitle &&
        !facts.originalContent
    ) {
        throw new Error(
            "Source article has neither a title nor article content."
        );
    }

    return facts;

}


/* ============================================================
   POLITICAL PARTY INSTRUCTIONS
============================================================ */

function buildPartyInstructions() {

    const dictionary = Object.entries(
        PARTY_NAMES
    )
        .map(([english, telugu]) =>
            `${english} = ${telugu}`
        )
        .join("\n");

    return `
MANDATORY POLITICAL PARTY NAME DICTIONARY:

${dictionary}

CRITICAL RULES:

1. Identify the political party from the original source.
2. Use the correct Telugu name from this dictionary.
3. Never transliterate English political party abbreviations letter by letter.
4. BJP MUST ALWAYS be written as బీజేపీ.
5. NEVER write BJP as బిఎజె, బాజ్, బీజీపీ or any other spelling.
6. TDP MUST ALWAYS be written as టీడీపీ.
7. YSR Congress MUST ALWAYS be written as వైఎస్సార్ కాంగ్రెస్.
8. Use the same spelling consistently in the headline, summary and every paragraph.
9. Do not confuse one political party with another.
10. If the party identity is uncertain, preserve its original English abbreviation instead of guessing.
11. Do not invent political affiliations for any person.
12. Do not change a party's identity even if a previous generated article contains an incorrect spelling.
`.trim();

}


/* ============================================================
   TELUGU LANGUAGE QUALITY INSTRUCTIONS
============================================================ */

function buildTeluguInstructions() {

    return `
TELUGU LANGUAGE QUALITY — MANDATORY:

You are writing for a respected Telugu newspaper.

Write like an experienced native Telugu newspaper editor.

LANGUAGE:

1. Use natural, modern and grammatically correct Telugu.
2. Use words understood by ordinary readers in Andhra Pradesh and Telangana.
3. Prefer simple Telugu instead of unnecessarily difficult literary vocabulary.
4. Do not translate English sentences word by word.
5. Understand the meaning first and then express it naturally in Telugu.
6. Use correct Telugu word order.
7. Ensure subject, verb, gender, number and tense agree.
8. Use correct Telugu spelling, word spacing and punctuation.
9. Avoid awkward English-to-Telugu translations.
10. Do not mix Telugu sentences with Korean, Chinese, Japanese, Arabic or unrelated foreign-language words.
11. Do not leave half-translated English expressions inside Telugu sentences.
12. Use English technical terms only when necessary.
13. Do not create unnatural Telugu words by combining English words with Telugu suffixes.
14. Avoid repetition and unnecessarily long sentences.
15. Every sentence must be understandable to an ordinary Telugu reader.

IMPORTANT EXAMPLES:

Incorrect: బస్సు breakdownలు
Correct: బస్సులు మార్గమధ్యలో నిలిచిపోవడం

Incorrect: Demonstrations జరిగింది
Correct: నిరసనలు జరిగాయి

Incorrect: జిల్లా పరిపాలక మండలి
Correct: జిల్లా పరిషత్

Incorrect: ఏకైకంగా ఎన్నికయ్యారు
Correct: ఏకగ్రీవంగా ఎన్నికయ్యారు

Incorrect: తను 강조ించారు
Correct: ఆయన నొక్కిచెప్పారు

Use the correct expression according to the actual context. These examples are not permission to replace words without checking their meaning.

EDITORIAL QUALITY:

1. Use accurate, meaningful headlines.
2. Do not exaggerate or sensationalise news.
3. Maintain political neutrality.
4. Clearly distinguish allegations from confirmed facts.
5. Do not turn proposals into approved decisions.
6. Do not turn expected events into completed events.
7. Never invent quotations.
8. Never change names, dates, numbers, amounts or statistics.
9. Do not add information from your own knowledge.
10. Do not mention AI or the source website.
`.trim();

}


/* ============================================================
   BUILD SYSTEM INSTRUCTIONS
============================================================ */

export function buildSystemPrompt(config = null) {

    const promptConfig =
        config || loadPromptConfig();

    const configuredInstructions =
        promptConfig.system.join("\n");

    return `
${configuredInstructions}

${buildPartyInstructions()}

${buildTeluguInstructions()}

FINAL PUBLICATION CHECK:

Before returning JSON, independently check:

- Every political party name against the original source.
- Every person's name against the original source.
- Every organisation and government department.
- Every place and location.
- Every date, number and statistic.
- Telugu grammar and spelling.
- Natural Telugu sentence structure.
- Untranslated or mixed-language expressions.
- Whether the headline accurately represents the news.

If BJP appears anywhere, its Telugu spelling must be బీజేపీ.

Do not return an article containing known incorrect party spellings.

Return only valid JSON matching the required schema.
`.trim();

}


/* ============================================================
   BUILD VERIFIED FACTS BLOCK
============================================================ */

function buildFactsBlock(article) {

    const facts = extractVerifiedFacts(article);

    return `
ORIGINAL VERIFIED NEWS INPUT
=============================

ORIGINAL HEADLINE:
${facts.originalTitle || "Not supplied"}

ORIGINAL SUMMARY:
${facts.originalSummary || "Not supplied"}

ORIGINAL ARTICLE CONTENT:
${facts.originalContent || "Not supplied"}

PUBLICATION DATE:
${facts.publishedDate || "Not supplied"}

CATEGORY:
${facts.category || "Not supplied"}

LOCATION:
${facts.originalLocation || "Not supplied"}

VERIFIED NAMES:
${facts.verifiedNames || "Not separately supplied"}

ADDITIONAL VERIFIED FACTS:
${facts.verifiedFacts || "Not separately supplied"}

IMPORTANT:
The original source information above is the factual reference.

Understand the complete news before writing.

Do not treat incorrect spellings in any previous AI-generated Telugu article as authoritative facts.

Identify political parties from the original English names and use their correct Telugu spellings.

Do not invent missing details.
`.trim();

}


/* ============================================================
   BUILD FINAL USER PROMPT

   Maintains compatibility with:
   const prompt = buildPrompt(article);
============================================================ */

export function buildPrompt(article, config = null) {

    const promptConfig =
        config || loadPromptConfig();

    const configuredUserInstructions =
        promptConfig.userPrompt.join("\n");

    const schema = JSON.stringify(
        promptConfig.articleSchema,
        null,
        2
    );

    const facts = buildFactsBlock(article);

    return `
${configuredUserInstructions}

${buildPartyInstructions()}

${buildTeluguInstructions()}

${facts}

REQUIRED JSON STRUCTURE:

${schema}

OUTPUT RULES:

1. Return exactly one JSON object.
2. Do not include Markdown code fences.
3. Do not include explanations outside JSON.
4. Do not add fields that are not in the schema.
5. Do not omit required schema fields.
6. Use the exact structure supplied above.
7. Use only verified facts.
8. Keep political party names consistent throughout the article.
9. Write the article in natural Telugu.
10. Proofread every sentence before returning the result.

FINAL STRICT CHECK:

If the original source identifies BJP, the generated Telugu article MUST use బీజేపీ.

The following spellings are forbidden:

${FORBIDDEN_TERMS.join(", ")}

Do not return any of these incorrect expressions.

Return only valid JSON.
`.trim();

}


/* ============================================================
   EXTRACT ARTICLE TEXT FOR VALIDATION
============================================================ */

export function getArticleText(article) {

    if (
        !article ||
        typeof article !== "object"
    ) {
        return "";
    }

    const sections = Array.isArray(
        article.sections
    )
        ? article.sections
        : [];

    const paragraphs = sections.flatMap(
        section => [
            cleanText(section?.heading),
            ...(Array.isArray(section?.paragraphs)
                ? section.paragraphs.map(cleanText)
                : [])
        ]
    );

    return [
        cleanText(article.headline),
        cleanText(article.summary),
        ...paragraphs,
        cleanText(article.location),
        ...(Array.isArray(article.tags)
            ? article.tags.map(cleanText)
            : [])
    ]
        .filter(Boolean)
        .join("\n");
}


/* ============================================================
   VALIDATE GENERATED TELUGU ARTICLE
============================================================ */

export function validateArticle(article, sourceArticle = null) {

    const errors = [];

    if (
        !article ||
        typeof article !== "object" ||
        Array.isArray(article)
    ) {
        return {
            valid: false,
            errors: ["Invalid article JSON object."]
        };
    }


    /* ----------------------------------------
       REQUIRED FIELDS
    ---------------------------------------- */

    if (!cleanText(article.headline)) {
        errors.push("Missing headline.");
    }

    if (!cleanText(article.summary)) {
        errors.push("Missing summary.");
    }

    if (
        !Array.isArray(article.sections) ||
        article.sections.length === 0
    ) {
        errors.push("At least one section is required.");
    }

    if (
        !Array.isArray(article.tags)
    ) {
        errors.push("Tags must be an array.");
    }

    if (
        !["normal", "high", "breaking"].includes(
            article.importance
        )
    ) {
        errors.push("Invalid importance value.");
    }


    /* ----------------------------------------
       SECTION VALIDATION
    ---------------------------------------- */

    if (Array.isArray(article.sections)) {

        article.sections.forEach(
            (section, index) => {

                if (
                    !section ||
                    typeof section !== "object"
                ) {
                    errors.push(
                        `Section ${index + 1} is invalid.`
                    );

                    return;
                }

                if (
                    !Array.isArray(section.paragraphs) ||
                    section.paragraphs.length === 0
                ) {
                    errors.push(
                        `Section ${index + 1} has no paragraphs.`
                    );
                }

                if (
                    Array.isArray(section.paragraphs)
                ) {

                    section.paragraphs.forEach(
                        (paragraph, paragraphIndex) => {

                            if (
                                typeof paragraph !== "string" ||
                                !paragraph.trim()
                            ) {
                                errors.push(
                                    `Section ${index + 1}, paragraph ${paragraphIndex + 1} is empty or invalid.`
                                );
                            }

                        }
                    );

                }

            }
        );

    }


    /* ----------------------------------------
       FORBIDDEN EXPRESSIONS
    ---------------------------------------- */

    const text = getArticleText(article);

    const lowerText = text.toLowerCase();

    FORBIDDEN_TERMS.forEach(
        term => {

            if (
                lowerText.includes(
                    term.toLowerCase()
                )
            ) {
                errors.push(
                    `Incorrect expression detected: ${term}`
                );
            }

        }
    );


    /* ----------------------------------------
       FOREIGN SCRIPT DETECTION

       Telugu and Latin characters are allowed.
       Other writing systems are flagged.
    ---------------------------------------- */

    const foreignScriptPattern =
        /[\u0900-\u097F\u1100-\u11FF\u3040-\u30FF\u3400-\u9FFF\u0600-\u06FF]/u;

    if (foreignScriptPattern.test(text)) {

        errors.push(
            "Foreign-language script detected. Telugu proofreading required."
        );

    }


    /* ----------------------------------------
       PARTY NAME CONSISTENCY

       Only check parties confirmed in the source.
    ---------------------------------------- */

    if (sourceArticle) {

        const sourceText = [
            cleanText(sourceArticle.title),
            cleanText(sourceArticle.text),
            cleanText(sourceArticle.content),
            cleanText(sourceArticle.description),
            cleanText(sourceArticle.excerpt)
        ].join(" ").toUpperCase();

        const partyChecks = [
            {
                source: /\bBJP\b|BHARATIYA JANATA PARTY/,
                correct: "బీజేపీ",
                name: "BJP"
            },
            {
                source: /\bTDP\b|TELUGU DESAM PARTY/,
                correct: "టీడీపీ",
                name: "TDP"
            },
            {
                source: /\bYSRCP\b|YSR CONGRESS/,
                correct: "వైఎస్సార్ కాంగ్రెస్",
                name: "YSR Congress"
            },
            {
                source: /\bBRS\b|BHARAT RASHTRA SAMITHI/,
                correct: "బీఆర్ఎస్",
                name: "BRS"
            }
        ];

        partyChecks.forEach(
            party => {

                if (
                    party.source.test(sourceText) &&
                    !text.includes(party.correct)
                ) {
                    errors.push(
                        `${party.name} is present in source but its correct Telugu name (${party.correct}) is missing from the article.`
                    );
                }

            }
        );

    }


    /* ----------------------------------------
       FINAL RESULT
    ---------------------------------------- */

    return {

        valid: errors.length === 0,

        errors

    };

}


/* ============================================================
   BUILD CORRECTION PROMPT

   Use this when validateArticle() returns valid:false.
============================================================ */

export function buildCorrectionPrompt(
    article,
    sourceArticle,
    validationErrors
) {

    const originalFacts =
        buildFactsBlock(sourceArticle);

    return `
You are the senior Telugu language editor of VIDHWAAN Telugu News.

Correct the supplied Telugu news article.

ORIGINAL VERIFIED FACTS:
${originalFacts}

ARTICLE THAT NEEDS CORRECTION:
${JSON.stringify(article, null, 2)}

VALIDATION ERRORS:
${JSON.stringify(validationErrors, null, 2)}

MANDATORY CORRECTIONS:

1. Correct every listed validation error.
2. Verify all political party names against the original source.
3. BJP must be written as బీజేపీ.
4. TDP must be written as టీడీపీ.
5. YSR Congress must be written as వైఎస్సార్ కాంగ్రెస్.
6. Remove unrelated foreign-language words.
7. Correct Telugu grammar and spelling.
8. Rewrite unnatural sentences in simple, natural Telugu.
9. Do not change verified facts, dates, names or numbers.
10. Do not invent information.
11. Preserve the original JSON structure.
12. Return only corrected JSON.
`.trim();

}


/* ============================================================
   EXPORT DEFAULT
============================================================ */

export default buildPrompt;
